		isNameInferred
		sourceColumn: [Hệ số tương quan]

	partition 'Product Correlation (Pearson)' = calculated
		mode: import
		source =
				UNION(
				ROW("Sản phẩm A", "TK thanh toán", "Sản phẩm B", "TK thanh toán", "Hệ số tương quan", (VAR TotN = COUNTROWS(prod_holding) VAR CX = COUNTROWS(FILTER(prod_holding, prod_holding[TK thanh toán]=1)) VAR CY = COUNTROWS(FILTER(prod_holding, prod_holding[TK thanh toán]=1)) VAR CXY = COUNTROWS(FILTER(prod_holding, prod_holding[TK thanh toán]=1 && prod_holding[TK thanh toán]=1)) RETURN DIVIDE(TotN*CXY - CX*CY, SQRT((TotN*CX - CX*CX)*(TotN*CY - CY*CY))))),
