table 'Product Penetration'
	lineageTag: 7e1253ef-775f-471c-bc62-97bc8f3991e0

	column Product
		lineageTag: 37bf4d8d-d984-4365-ad21-1613caa766c6
		isNameInferred
		sourceColumn: [Product]

	column Holders
		dataType: int64
		formatString: #,0
		lineageTag: 6bce0146-0200-4b77-813f-1a3ae86110a8
		isNameInferred
		sourceColumn: [Holders]

	column Penetration
		dataType: double
		formatString: 0%
		lineageTag: 796a7529-d890-4390-b934-78abc6736231
		isNameInferred
		sourceColumn: [Penetration]

	partition 'Product Penetration' = calculated
		mode: import
		source =
				UNION(
				ROW("Product", "TK thanh toán", "Holders", COUNTROWS(FILTER(prod_holding, prod_holding[TK thanh toán]=1)), "Penetration", DIVIDE(COUNTROWS(FILTER(prod_holding, prod_holding[TK thanh toán]=1)), COUNTROWS(prod_holding))),
				ROW("Product", "Tiền gửi có kỳ hạn", "Holders", COUNTROWS(FILTER(prod_holding, prod_holding[Tiền gửi có kỳ hạn]=1)), "Penetration", DIVIDE(COUNTROWS(FILTER(prod_holding, prod_holding[Tiền gửi có kỳ hạn]=1)), COUNTROWS(prod_holding))),
				ROW("Product", "Thẻ tín dụng", "Holders", COUNTROWS(FILTER(prod_holding, prod_holding[Thẻ tín dụng]=1)), "Penetration", DIVIDE(COUNTROWS(FILTER(prod_holding, prod_holding[Thẻ tín dụng]=1)), COUNTROWS(prod_holding))),
				ROW("Product", "App ngân hàng", "Holders", COUNTROWS(FILTER(prod_holding, prod_holding[App ngân hàng]=1)), "Penetration", DIVIDE(COUNTROWS(FILTER(prod_holding, prod_holding[App ngân hàng]=1)), COUNTROWS(prod_holding))),
				ROW("Product", "Vay thế chấp", "Holders", COUNTROWS(FILTER(prod_holding, prod_holding[Vay thế chấp]=1)), "Penetration", DIVIDE(COUNTROWS(FILTER(prod_holding, prod_holding[Vay thế chấp]=1)), COUNTROWS(prod_holding))),
				ROW("Product", "Vay tín chấp", "Holders", COUNTROWS(FILTER(prod_holding, prod_holding[Vay tín chấp]=1)), "Penetration", DIVIDE(COUNTROWS(FILTER(prod_holding, prod_holding[Vay tín chấp]=1)), COUNTROWS(prod_holding))))

	annotation PBI_ResultType = Table

